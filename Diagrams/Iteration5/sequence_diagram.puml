@startuml Iteration5_Sequence_Diagram
title Firefighting Drone Swarm - Iteration 5 Sequence Diagram
skinparam sequenceMessageAlign center

actor User
participant "FireIncidentSubsystem" as Fire
participant "Scheduler" as Sched
participant "DroneSubsystem\n(Drone 1)" as D1
participant "DroneSubsystem\n(Drone 2)" as D2
participant "GuiModel" as GUI

== Initialization ==

D1 -> Sched : DRONE_REGISTER|1|30.0|0|0
Sched -> GUI : setDroneState(1, IDLE)\nsetDronePosition(1, 0, 0)

D2 -> Sched : DRONE_REGISTER|2|30.0|0|0
Sched -> GUI : setDroneState(2, IDLE)\nsetDronePosition(2, 0, 0)

== Normal Fire Dispatch (HIGH severity, 30L needed) ==

Fire -> Sched : FIRE_EVENT|14:03:15|3|FIRE_DETECTED|HIGH|NONE
Sched -> GUI : addActiveFire(3, HIGH)

note over Sched
  findBestDrone():
  - Drone 1: IDLE, agent=30.0 >= 30 -> eligible
  - Drone 2: IDLE, agent=30.0 >= 30 -> eligible
  - Select closest to Zone 3
end note

Sched -> D1 : DRONE_COMMAND|1|TASK|3|HIGH|NONE
Sched -> GUI : setDroneState(1, EN_ROUTE)\nsetDroneAssignment(1, 3)

D1 -> Sched : DRONE_STATUS|1|EN_ROUTE|...|30.0
D1 -> Sched : DRONE_STATUS|1|DROPPING_AGENT|...|30.0
Sched -> GUI : setDroneState(1, DROPPING_AGENT)

D1 -> Sched : DRONE_RESULT|1|3|true|0.0
Sched -> GUI : setDroneState(1, IDLE)\nremoveActiveFire(3)

note over Sched
  remainingAgent (0.0) < 10
  -> sendReturnBase(Drone 1)
end note

Sched -> D1 : DRONE_COMMAND|1|RETURN_BASE|0|NONE
Sched -> GUI : setDroneState(1, RETURNING_BASE)

Sched -> Fire : CONFIRMATION|1|3|true

== Agent Refill at Base ==

D1 -> D1 : Travel to base (0,0)\ncurrentAgent = 30.0 (refill)
D1 -> Sched : DRONE_STATUS|1|IDLE|0|0|30.0
Sched -> GUI : setDroneState(1, IDLE)\nsetDronePosition(1, 0, 0)

== Dispatch with Pre-Task Capacity Check ==

Fire -> Sched : FIRE_EVENT|14:03:20|1|FIRE_DETECTED|LOW|DRONE_STUCK
Sched -> GUI : addActiveFire(1, LOW)

note over Sched
  findBestDrone():
  - LOW severity needs 10L
  - Both drones have 30L -> eligible
end note

Sched -> D1 : DRONE_COMMAND|1|TASK|1|LOW|DRONE_STUCK
Sched -> GUI : setDroneState(1, EN_ROUTE)

== Soft Fault: DRONE_STUCK ==

note over D1 #FFCCCC
  Fault injected: DRONE_STUCK
  Drone freezes mid-flight
end note

D1 -> Sched : DRONE_FAULT|1|DRONE_STUCK|1
Sched -> GUI : setDroneFault(1, DRONE_STUCK)

note over Sched
  Soft fault -> re-queue Zone 1
  Drone 1 assignment cleared
end note

Sched -> GUI : addActiveFire(1, LOW)

D1 -> D1 : Self-recover after 3s
D1 -> Sched : DRONE_STATUS|1|RETURNING_BASE|...|30.0
D1 -> D1 : Return to base, refill
D1 -> Sched : DRONE_STATUS|1|IDLE|0|0|30.0
Sched -> GUI : setDroneState(1, IDLE)\nsetDroneFault(1, NONE)

== Re-dispatch after Fault Recovery ==

note over Sched
  Zone 1 still pending
  findBestDrone(): Drone 2 closer
end note

Sched -> D2 : DRONE_COMMAND|2|TASK|1|LOW|NONE
Sched -> GUI : setDroneState(2, EN_ROUTE)\nsetDroneAssignment(2, 1)

D2 -> Sched : DRONE_RESULT|2|1|true|20.0
Sched -> GUI : setDroneState(2, IDLE)\nremoveActiveFire(1)
Sched -> Fire : CONFIRMATION|2|1|true

== Hard Fault: NOZZLE_STUCK ==

Fire -> Sched : FIRE_EVENT|14:06:00|7|FIRE_DETECTED|HIGH|NOZZLE_STUCK
Sched -> D1 : DRONE_COMMAND|1|TASK|7|HIGH|NOZZLE_STUCK

D1 -> Sched : DRONE_STATUS|1|DROPPING_AGENT|...|30.0

note over D1 #FF9999
  Fault injected: NOZZLE_STUCK
  Nozzle jams during drop
  HARD FAULT -> permanent OFFLINE
end note

D1 -> Sched : DRONE_FAULT|1|NOZZLE_STUCK|7
Sched -> GUI : setDroneFault(1, NOZZLE_STUCK)\nsetDroneState(1, OFFLINE)

note over Sched
  Hard fault -> Drone 1 permanently offline
  Re-queue Zone 7
end note

Sched -> GUI : addActiveFire(7, HIGH)

note over Sched
  findBestDrone(): Only Drone 2 available
end note

Sched -> D2 : DRONE_COMMAND|2|TASK|7|HIGH|NONE
D2 -> Sched : DRONE_RESULT|2|7|true|0.0
Sched -> GUI : removeActiveFire(7)
Sched -> Fire : CONFIRMATION|2|7|true

== Shutdown ==

Fire -> Sched : SHUTDOWN
Sched -> D1 : DRONE_COMMAND|1|SHUTDOWN|0|NONE
Sched -> D2 : DRONE_COMMAND|2|SHUTDOWN|0|NONE
Sched -> Fire : SHUTDOWN

@enduml
